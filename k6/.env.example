# cp .env.example .env 후 값 채우기.
# 설치된 k6 버전은 --env-file을 지원하지 않아서, 실행 전에 셸에서 source로 불러와야 한다
# (k6는 --include-system-env-vars 기본값이 true라 export된 값을 __ENV로 그대로 읽는다):
#   set -a && source .env && set +a && k6 run scenarios/spike.js

# 테스트 대상. 로컬 docker-compose는 http://localhost:3000,
# 클러스터는 http://<INGRESS_HOST> (docs/setup/fresh-environment-setup.md 5번 참고)
BASE_URL=http://localhost:3000

# setup()에서 생성할 테스트 쿠폰 총 수량
COUPON_QUANTITY=100000

# spike.js 전용 — 동시에 발급을 시도할 가상 사용자 수 (각자 정확히 1회 요청)
# 로컬 스모크 테스트는 200~500 정도로 낮춰서 먼저 확인 후, 클러스터에서 수천 단위로 올릴 것
SPIKE_VUS=500

# spike.js 전용 — 시나리오 최대 허용 시간
SPIKE_MAX_DURATION=3m

# --- scripts/run.sh 전용: 테스트 종료 후 자동 정리(cleanup.sql)에 쓰는 Postgres 접속 정보 ---
# 로컬 docker-compose 기본값 (backend/docker-compose.yml의 DB_LOCAL_PORT 기본값 5433, 호스트에 포트가 열려 있어 psql로 직접 접속 가능)
# 클러스터 대상이면 deploy/external-db/.env 값(DB_HOST=외부 Postgres의 Tailscale IP, POSTGRES_PORT)과 동일하게 채울 것
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=rush_coupon
