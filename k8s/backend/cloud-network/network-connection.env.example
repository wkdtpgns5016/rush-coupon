# #59(S3+CloudFront) 완료 후 실제 배포된 CloudFront 도메인으로 교체
CORS_ORIGIN=https://0.0.0.0.cloudfront.net

# terraform/cloud-infra output: elasticache_endpoint
VALKEY_HOST=0.0.0.0
VALKEY_PORT=6379

# terraform/cloud-infra output: mq_amqp_endpoint (amqps://host:5671 형태 — host:port만 뽑아서 적는다)
# 주의: Amazon MQ는 AMQPS(TLS)만 지원하고 평문 AMQP(5672)가 없다. 지금 backend 코드
# (backend/src/rabbitmq/rabbitmq.module.ts)는 amqp://만 하드코딩돼 있어서 이 값을 넣어도
# 당장은 연결이 안 된다 — TLS 지원 코드 변경은 #58에서 처리 예정.
RABBITMQ_HOST=0.0.0.0
RABBITMQ_PORT=5671
