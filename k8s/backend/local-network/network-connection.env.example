INGRESS_HOST=backend.0.0.0.0.nip.io
CORS_ORIGIN=http://0.0.0.0:8080

# valkey/rabbitmq는 클러스터 내부 Service 이름이라 사실상 바뀌지 않는 값이지만,
# base/deployment.yaml이 cloud와 같은 ConfigMap(backend-network)을 참조하게 되면서
# 여기도 채워야 하는 키가 됐다 (예전엔 Deployment에 하드코딩돼 있었음).
VALKEY_HOST=valkey
VALKEY_PORT=6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
