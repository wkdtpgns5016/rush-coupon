# cp terraform.tfvars.example terraform.tfvars 후 값을 채운다. terraform.tfvars는 git에 커밋하지 않는다.

# cat ~/.ssh/id_ed25519.pub 의 결과를 그대로 붙여넣는다.
ssh_public_key = ""

# https://login.tailscale.com/admin/settings/keys 에서 발급 (Reusable + Ephemeral 권장, 만료시간 짧게).
# ephemeral 변수라 state에 남지 않는다 — SSM Parameter Store(write-only)로만 전달된다.
tailscale_authkey = ""

# authkey를 교체(로테이션)할 때만 1씩 올린다. 그대로면 SSM 파라미터를 갱신하지 않는다.
# tailscale_authkey_version = 1
