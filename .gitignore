# Environment variables
.env
.env.local
*.env
!.env.example

# deploy 브랜치엔 app 소스가 트래킹되지 않음 (main/issue 브랜치 전환 시 로컬에 남는 디렉토리)
/backend/
/frontend/

# ArgoCD는 git에 커밋된 내용만 읽을 수 있어서, kustomize configMapGenerator가
# 참조하는 값은 비밀이 아닌 이상 커밋되어야 함 (Tailscale IP는 비밀 아님)
!k8s/backend/overlays/local/registry-connection.env
!k8s/backend/overlays/local/network-connection.env
