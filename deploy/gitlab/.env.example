# ==============================================================================
# deploy/gitlab/.env 템플릿   (cp .env.example .env 후 값을 채웁니다)
# 전체 절차: docs/setup/fresh-environment-setup.md
#
# 표기
#   [필수] 직접 입력해야 함 (비우거나 자리표시자 그대로면 나중에 조용히 실패)
#   [자동] 스크립트가 채움 → 비워두세요
#   [선택] 비우면 해당 항목은 건너뜀
#
# 규칙
#   - 값에 따옴표를 쓰지 않습니다.
#   - 같은 줄에 주석을 달지 않습니다 (주석은 항상 윗줄에).
#   - 0.0.0.0 은 "반드시 실제 값으로 바꿔야 하는 자리표시자"입니다.
#   - "Tailscale IP"는 `tailscale ip -4` 로 확인한 100.x.x.x 주소입니다.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1) GitLab 서버   — 6-1 ./up.sh 실행 전에 채움
# ------------------------------------------------------------------------------

# [필수] GitLab을 올릴 머신(이 Mac)의 Tailscale IP. 포트 없이 IP만.
# GitHub Actions Variables 의 GITLAB_HOST 와 같은 값입니다.
GITLAB_HOST=0.0.0.0

# [필수] http:// + 위 GITLAB_HOST. 끝에 / 나 포트를 붙이지 않습니다.
# 예: http://100.113.87.50
GITLAB_EXTERNAL_URL=http://0.0.0.0

# 80 에서 바꾸지 마세요. bootstrap 스크립트와 GitHub Actions 가 포트 없이
# http://GITLAB_HOST 로 접속합니다.
GITLAB_HTTP_PORT=80

# 아래 FRONTEND_SSH_PORT 와 겹치면 안 됩니다.
GITLAB_SSH_PORT=2222

# Container Registry 포트. 문서 6-3(Docker insecure-registries), 8번(containerd hosts.toml)의
# <GITLAB_HOST>:5050 과 같은 포트여야 합니다.
GITLAB_REGISTRY_PORT=5050

# [필수] GitLab root 로그인 비밀번호 (8자 이상). 작은따옴표(') 는 GitLab 설정에
# 그대로 삽입되어 깨지므로 넣지 마세요.
GITLAB_ROOT_PASSWORD=your_secure_password_here


# ------------------------------------------------------------------------------
# 2) bootstrap-gitlab.sh   — ./up.sh 가 실행. 새 인스턴스에서 1회만
# ------------------------------------------------------------------------------

# [자동] bootstrap 이 발급/저장합니다. 직접 입력하지 마세요.
TOKEN=
PROJECT_ID=

# [선택] mirror 토큰의 bot 유저명을 이 이름으로 바꿉니다 (GitHub Secret GITLAB_DEPLOY_USER 값).
# 비우면 project_<id>_bot_<랜덤> 이름이 그대로 쓰입니다.
GITLAB_BOT=GITLAB_BOT


# ------------------------------------------------------------------------------
# 3) register-ci-variables.sh   — 문서 7번. 1(Frontend)·2(Postgres)·5(Ingress)·6(GitLab) 완료 후
#    값이 빈 항목은 건너뛰고, 이미 등록된 변수는 갱신하지 않습니다 (바꿀 땐 GitLab UI 또는 API PUT).
# ------------------------------------------------------------------------------

# [필수] backend-deploy job 이 deploy 브랜치에 push 할 때 쓰는 GitHub Personal Access Token.
# 이 레포에 push 할 수 있는 권한(repo)이 필요합니다. 비우면 등록이 건너뛰어져 backend-deploy 가 실패합니다.
GITHUB_PAT=

# [필수] frontend 가 호출할 backend 주소. 빌드 시점에 번들에 박힙니다.
# 형식: http:// + 문서 5번의 INGRESS_HOST.  http:// 를 빼먹거나 끝에 / 를 붙이지 마세요.
#   (http:// 가 빠지면 브라우저가 상대경로로 취급해서 화면에서 "쿠폰 정보를 불러오지 못했습니다"가 뜹니다)
# 예: http://backend.100.71.107.68.nip.io
VITE_API_BASE_URL=http://backend.0.0.0.0.nip.io

# [필수] Frontend 컨테이너를 올린 머신의 Tailscale IP (GitLab 과 같은 머신이면 GITLAB_HOST 와 동일).
FRONTEND_HOST=0.0.0.0

# [필수] deploy/frontend/.env 의 FRONTEND_SSH_PORT 와 같은 값. 위 GITLAB_SSH_PORT 와는 달라야 합니다
# (같으면 GitLab sshd 로 접속을 시도해서 Permission denied).
FRONTEND_SSH_PORT=2223

# [필수] 1번에서 만든 CI 배포용 SSH 개인키 경로 (공개키 .pub 가 아님). 따옴표 없이.
# 스크립트가 이 파일을 base64 로 인코딩해서 FRONTEND_SSH_PRIVATE_KEY 로 등록합니다.
FRONTEND_SSH_KEY_PATH=~/.ssh/gitlab_ci_frontend_deploy

# backend-deploy 가 배포할 때마다 schema.sql 을 적용하는 외부 Postgres 접속 정보.
# deploy/external-db/.env 의 값과 같아야 합니다.
#   EXTERNAL_DB_HOST     : Postgres 컨테이너를 올린 머신의 Tailscale IP
#   EXTERNAL_DB_PORT     : POSTGRES_PORT (호스트 포트. k8s Secret 의 DB_PORT 와는 별개)
#   EXTERNAL_DB_NAME/USER/PASSWORD : POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD
EXTERNAL_DB_HOST=0.0.0.0
EXTERNAL_DB_PORT=5432
EXTERNAL_DB_NAME=rush_coupon
EXTERNAL_DB_USER=coupon_user
EXTERNAL_DB_PASSWORD=your_secure_password_here
